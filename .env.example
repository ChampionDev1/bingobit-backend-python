# Service URLs
SYSTEMWALLET_SERVICE_URL=localhost:50052
ONCHAIN_SERVICE_URL=localhost:50051

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Database Configuration
DB_HOST=192.168.1.47
DB_PORT=5432
DB_NAME=bingobit
DB_USER=postgres
DB_PASSWORD=this

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Solana Configuration (Devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Hot Wallet Configuration (KEEP SECURE!)
SOLANA_HOT_WALLET_ADDRESS=
SOLANA_HOT_WALLET_PRIVATE_KEY=

# Transaction Configuration
MIN_CONFIRMATIONS=15
TRANSACTION_TIMEOUT=60
MAX_RETRIES=3

# Fee Configuration (in lamports)
SOLANA_BASE_FEE=5000
SOLANA_PRIORITY_FEE=10000
SOLANA_RENT_EXEMPT_MINIMUM=890880

# Monitoring Configuration
POLL_INTERVAL_SECONDS=2
BATCH_SIZE=100

# Minimum amounts (in lamports for Solana)
MIN_DEPOSIT_AMOUNT=10000000
DUST_THRESHOLD=5000
